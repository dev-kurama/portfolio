# Copy to .env (or export in your shell / hosting dashboard). All optional.
PORT=5001

# Environment: development | production
# Use production for deploying behind HTTPS reverse proxy
NODE_ENV=production

# Where "Establish connection" messages are emailed. Defaults to the address on your resume.
CONTACT_TO=Devyanshukaushik08@gmail.com

# Set SMTP_HOST to also receive contact messages by email.
# Without it, messages are still saved to data/messages.jsonl only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Example Gmail SMTP settings:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password
# SMTP_FROM=noreply@example.com
